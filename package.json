{
  "name": "dsh-kingdom",
  "version": "0.4.0",
  "description": "独立 dsh 插件：安装后会话内初始化/接入本地王国，Territory/Binding CRUD（v0.4 支持解绑与角色↔独立会话归属）+ Task 治理闭环（Worker Claim ≠ Fact）+ Execution 生命周期 + 本地 GUI 通道",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "license": "BSD-3-Clause",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "kingdom",
    "governance",
    "multi-agent"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lusblead/dsh-Kingdom.git"
  },
  "bugs": {
    "url": "https://github.com/lusblead/dsh-Kingdom/issues"
  },
  "homepage": "https://github.com/lusblead/dsh-Kingdom#readme",
  "engines": {
    "node": ">=22.19"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-commands": ">=0.0.1-rc.1 <0.1.0 || >=0.1.0-rc.1 <0.2.0-0",
    "@deepseek-ai/dsh-llm": ">=0.0.1-rc.1 <0.1.0 || >=0.1.0-rc.1 <0.2.0-0",
    "@deepseek-ai/dsh-tools": ">=0.0.1-rc.1 <0.1.0 || >=0.1.0-rc.1 <0.2.0-0",
    "cordis": ">=4.0.0-rc <5",
    "@deepseek-ai/schemastery": "^3.18.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "^5.9.0"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit"
  }
}
