{
  "name": "dsh-kingdom",
  "version": "3.2.0",
  "description": "个人 Agent 工作台：任务交付可逐条查看、知悉与提问，改动证据可追溯；Worker Claim 仍须主管审查才成为事实。",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "NOTICE",
    "THIRD_PARTY_NOTICES.md",
    "ASSETS_NOTICE.md",
    "docs/V2.0-USER-GUIDE.md",
    "docs/V2.0-RELEASE-NOTES.md",
    "docs/V3.0-USER-GUIDE.md",
    "docs/V3.0-RELEASE-NOTES.md",
    "docs/V3.1-RELEASE-NOTES.md",
    "docs/V3.2-RELEASE-NOTES.md",
    "docs/DSH-KINGDOM-3.0-ANNOUNCEMENT.md"
  ],
  "license": "AGPL-3.0-or-later",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "kingdom",
    "governance",
    "multi-agent"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lusblead/dsh-Kingdom.git"
  },
  "bugs": {
    "url": "https://github.com/lusblead/dsh-Kingdom/issues"
  },
  "homepage": "https://github.com/lusblead/dsh-Kingdom#readme",
  "engines": {
    "node": ">=22.19"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-commands": ">=0.1.5-rc.1 <0.1.6-0 || >=0.1.7-0 <0.1.8-0",
    "@deepseek-ai/dsh-llm": ">=0.1.5-rc.1 <0.1.6-0 || >=0.1.7-0 <0.1.8-0",
    "@deepseek-ai/dsh-tools": ">=0.1.5-rc.1 <0.1.6-0 || >=0.1.7-0 <0.1.8-0",
    "@deepseek-ai/dsh-token-meter": ">=0.1.5-rc.2 <0.1.6-0 || >=0.1.7-0 <0.1.8-0",
    "@deepseek-ai/cordis": ">=4.0.0-rc <5",
    "@deepseek-ai/schemastery": "^3.18.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-token-meter": { "optional": true }
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "^5.9.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node src/gui/prepare-character-assets.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test tests/*.test.ts",
    "prepack": "npm run build"
  }
}
